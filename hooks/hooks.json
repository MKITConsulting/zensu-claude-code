{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/plan-approved-delegate.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tdd-review-delegate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-review-tdd-delegate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'HEAD=$(git rev-parse HEAD 2>/dev/null) || { echo \"zensu: not a git repository, pulse session skipped\"; exit 0; }; BRANCH=$(git branch --show-current 2>/dev/null); [ -z \"$BRANCH\" ] && BRANCH=\"detached\"; echo \"zensu: pulse session ready — HEAD=$HEAD branch=$BRANCH\"'"
          }
        ]
      }
    ]
  }
}
