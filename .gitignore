# OS
.DS_Store
Thumbs.db

# Editors / IDEs
/.idea/
.vscode/
*.swp
*.swo
*~

# Environment & secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# Logs
*.log
# But keep checked-in fixture log files used by eval tests
!evals/tdd-review-chain/fixtures/*.log
!evals/tdd-manager-pretool/fixtures/**/*.log

# Dependencies
node_modules/
vendor/

# E2E fixture artifacts (per-fixture deps + lockfiles)
tests/e2e/fixtures/
tests/e2e/results/
tests/e2e-plm/fixtures/*
!tests/e2e-plm/fixtures/live-regressions/
!tests/e2e-plm/fixtures/live-regressions/*.txt
tests/e2e-plm/results/

# Build output
dist/
build/
out/

# Claude Code
.claude/plans/
.claude/settings.local.json
.claude/worktrees/

# tdd-manager run artifacts (per-run plans + logs)
.zensu/*
!.zensu/plans/
!.zensu/logs/
!.zensu/logs/*.log
# Witness logs are ephemeral per-session anti-hallucination evidence (consumed
# only by the in-session Phase 6 cross-check). Keep them local; never commit.
.zensu/logs/witness-*.log
!.zensu/config.json

# Internal
OSS_READINESS_REPORT.md
evals/tdd-manager/**
